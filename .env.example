# 高德开放平台 —— Web 端（JS API）应用的 Key
# 申请地址：https://console.amap.com/dev/key/app
# 创建应用时「服务平台」请选择：Web 端 ( JS API )
VITE_AMAP_KEY=

# 与 Key 配套的安全密钥（securityJsCode）
VITE_AMAP_SECURITY_CODE=

# Supabase 项目 URL 与 anon key（跨设备数据同步）
# 项目控制台：https://supabase.com/dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
